{
  "agent": "orquestrador",
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./out/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Read(./.vercel/**)",
      "Read(./*.tsbuildinfo)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./supabase/.temp/**)",
      "Read(./supabase/.branches/**)",
      "Read(./*.sqlite)",
      "Read(./*.sqlite3)",
      "Read(./uploads/**)",
      "Read(./tmp/**)",
      "Read(./.cache/**)",
      "Read(./logs/**)",
      "Read(./**/*.log)"
    ],
    "allow": [
      "mcp__memoria-projeto__buscar_memoria",
      "mcp__memoria-projeto__pendencias",
      "mcp__memoria-projeto__doc_modulo"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/orcamento-contexto/check.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/.claude/scripts/hook.ts\" prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/.claude/scripts/hook.ts\" subagent-stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/.claude/scripts/hook.ts\" session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
