# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (anon); pode ir ao navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço; SOMENTE no servidor. Nunca expor ao navegador
SUPABASE_SERVICE_ROLE_KEY=

# Gemini como assistente (scripts/gemini-assist.mjs). Só neste arquivo local; nunca versionar
GEMINI_API_KEY=
# Opcional: modelo (padrão gemini-flash-latest)
GEMINI_MODEL=
